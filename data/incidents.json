    "incident_id": "INC-007",
    "title": "orders-api HTTP 500 after release v2.7.9",
    "severity": "SEV-1",
    "service": "orders-api",
    "environment": "production",
    "status": "resolved",
    "started_at": "2026-09-29T08:03:00Z",
